[resource]
script = ExtResource("1_orc")
Name = "Orc Archer"
Description = "Orcs with black-fletched arrows and short bows of horn. They loose them from the back of the horde at anything that moves. Their aim is poor and their hides are thin, but their arrows are many. Like elven archers, they're useless with a knife and won't strike back up close."
MaxHealth = 30
Strength = 7
Defense = 2
SpeedTier = 4
CanRetaliate = false
MeleeAttack = SubResource("Resource_melee")
LongRangeAttack = SubResource("Resource_ranged")
Model = ExtResource("4_orc")
metadata/_custom_type_script = "uid://cj3g6btx1kotr"
