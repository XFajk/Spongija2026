[resource]
script = ExtResource("3_srmyx")
Name = "Melkor"
Description = "The Dark Enemy himself, mightiest of the Valar and the first to turn against them. He walks the ruins of his stronghold on Shadow Hill in a shape of night, and every horror of the forest answers to him. His blows break shields, and his fire burns through any armor. Only the bravest host should climb the hill, and only it can win back the great horn of Oromë."
MaxHealth = 5000
Strength = 500
Defense = 25
SpeedTier = 7
StartingMana = 60
