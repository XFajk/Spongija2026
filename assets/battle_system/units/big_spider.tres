[resource]
script = ExtResource("3_hc6ia")
Name = "Big Spider"
Description = "The Spider Queen. Born of the dark that Melkor let loose in Middle-earth, she rules the Deep Thicket from a nest of grey silk and old bones. She doesn't chase her prey. She spits strands of web over it, and once they've bound its legs, even the swiftest move like they're wading through tar."
