[resource]
script = ExtResource("1_orc")
Name = "Orc Thrall"
texture = ExtResource("5_icon")
Description = "Quendi who were taken in the dark before Oromë came, and twisted in Melkor's pits into something cruel and hateful. Thralls are the lowest of his orcs, driven to battle with whips and pitchforks. They are tougher and meaner than the pilgrims they once were, but no braver: they come in hordes because alone they would run."
MaxHealth = 25
Strength = 4
Defense = 2
SpeedTier = 4
MeleeAttack = SubResource("Resource_melee")
