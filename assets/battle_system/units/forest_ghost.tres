[resource]
script = ExtResource("1_ghost")
Name = "Forest Ghost"
texture = ExtResource("6_3an5d")
Description = "Restless spirits of those who died in the dark of the forest, bound to Shadow Hill by Melkor's will. Arrows pass through them as through mist, so only blade and spell can touch them. Once a battle, they call their fallen kin back from the shadows. Not all of them serve the dark gladly: a host strong enough might win them over, and learn their art."
MaxHealth = 30
Strength = 7
Defense = 5
SpeedTier = 5
StartingMana = 15
MaxMana = 15
MeleeAttack = SubResource("Resource_melee")
