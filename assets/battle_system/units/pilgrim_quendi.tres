[resource]
script = ExtResource("3_qqub5")
Name = "Pilgrim Quendi"
texture = ExtResource("6_q36qr")
Description = "Elves of the Great Journey, who left the waters of Cuiviénen to follow Oromë into the west. They carry staves and walking poles rather than swords, and fall easily, but there are many of them, and every camp along the road sends more. Taught and armed, they become archers, warriors and riders."
MaxHealth = 20
Strength = 3
Defense = 2
